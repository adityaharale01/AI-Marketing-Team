:host {
  display: block;
  min-height: 100vh;
  color: #342a3b;
}

.dashboard-shell {
  display: flex;
  min-height: 100vh;
  background: #f8f7fb;
  position: relative;
}

/* =========================================================
   MOBILE HEADER & OVERLAY (Default hidden on desktop)
   ========================================================= */

.mobile-topbar {
  display: none;
}

.mobile-drawer-overlay {
  display: none;
}

.mobile-sidebar-head {
  display: none;
}

/* =========================================================
   SIDEBAR (Desktop)
   ========================================================= */

.sidebar {
  width: 250px;
  flex: 0 0 250px;
  background: #ffffff;
  border-right: 1px solid #eeeaf2;
  padding: 24px 16px 20px;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
  z-index: 100;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 8px 24px;
  text-decoration: none;
  color: #30263a;
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -0.6px;
}

.brand-symbol {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  background: #704be4;
  color: #ffffff;
  border-radius: 11px;
  font-size: 22px;
  box-shadow: 0 4px 12px rgba(112, 75, 228, 0.25);
}

.brand-dot {
  color: #8058ed;
}

.brand small {
  display: block;
  font-size: 8px;
  letter-spacing: 1.4px;
  color: #a49aaf;
  margin-top: 3px;
  font-weight: 700;
}

.workspace-label,
.nav-caption {
  font-size: 9px;
  letter-spacing: 1.3px;
  font-weight: 800;
  color: #aaa1b3;
  margin: 16px 10px 6px;
  text-transform: uppercase;
}

.business-switch {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  border: 1px solid #eee8f4;
  background: #fcfbfe;
  padding: 10px 12px;
  border-radius: 11px;
  text-align: left;
  cursor: pointer;
  color: #493c55;
  transition: all 0.15s ease;
}

.business-switch:hover {
  background: #f7f3ff;
  border-color: #dfd3fc;
}

.business-avatar {
  width: 30px;
  height: 30px;
  border-radius: 9px;
  background: #eee7ff;
  color: #704be4;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  font-size: 14px;
}

.business-switch-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.business-switch-copy strong {
  font-size: 11px;
  color: #342a3b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.business-switch-copy small {
  font-size: 9px;
  color: #9a8bb9;
}

.business-menu {
  margin-top: 6px;
  border: 1px solid #eee8f4;
  background: #ffffff;
  border-radius: 10px;
  padding: 6px;
  box-shadow: 0 6px 20px rgba(50, 30, 70, 0.08);
}

.business-menu button {
  display: block;
  width: 100%;
  text-align: left;
  border: 0;
  background: #ffffff;
  padding: 8px 10px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 600;
  color: #493c55;
  cursor: pointer;
  transition: background 0.15s;
}

.business-menu button:hover {
  background: #f6f2ff;
  color: #704be4;
}

.business-menu small {
  display: block;
  color: #a49aac;
  font-size: 9px;
  font-weight: 400;
  margin-top: 2px;
}

.business-menu .add-business {
  color: #704be4;
  font-weight: 700;
  border-top: 1px solid #f2edf7;
  margin-top: 4px;
  padding-top: 8px;
}

.side-link {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  color: #6d627a;
  font-size: 12px;
  font-weight: 600;
  padding: 10px 12px;
  border-radius: 9px;
  margin: 2px 0;
  transition: all 0.15s ease;
}

.side-link span {
  width: 20px;
  text-align: center;
  font-size: 16px;
  color: #8c8297;
}

.side-link:hover {
  background: #f7f3ff;
  color: #704be4;
}

.side-link:hover span {
  color: #704be4;
}

.side-link.active {
  background: #f0ebff;
  color: #6843d4;
  font-weight: 700;
}

.side-link.active span {
  color: #704be4;
}

.sidebar-bottom {
  margin-top: auto;
  padding-top: 16px;
}

.help-card {
  background: #f7f3ff;
  border: 1px solid #eee7ff;
  border-radius: 11px;
  padding: 12px 14px;
  color: #6843d4;
  font-size: 11px;
  font-weight: 700;
  line-height: 1.5;
  margin-bottom: 12px;
}

.help-card small {
  display: block;
  color: #9c90b4;
  font-size: 9px;
  font-weight: 400;
  margin-top: 4px;
}

.sidebar-user-box {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 6px 0;
  border-top: 1px solid #f0edf4;
}

.avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #eee6ff;
  color: #704bdb;
  display: grid;
  place-items: center;
  font-size: 13px;
  font-weight: 800;
}

.sidebar-user-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex: 1;
  min-width: 0;
}

.sidebar-user-info strong {
  font-size: 11px;
  color: #3d2f4a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-user-info small {
  font-size: 9px;
  color: #a39aab;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logout-btn {
  border: 0;
  background: none;
  color: #8f849a;
  cursor: pointer;
  font-size: 18px;
  padding: 4px;
  border-radius: 6px;
  transition: color 0.15s;
}

.logout-btn:hover {
  color: #704be4;
}

/* =========================================================
   DASHBOARD MAIN CONTENT
   ========================================================= */

.dashboard-main {
  flex: 1;
  min-width: 0;
  max-width: 1500px;
  margin: 0 auto;
  padding: 32px clamp(20px, 4vw, 54px) 30px;
}

.dashboard-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 24px;
}

.section-kicker {
  font-size: 10px;
  letter-spacing: 1.25px;
  font-weight: 800;
  color: #9277ce;
  text-transform: uppercase;
}

.dashboard-topbar h1 {
  font-size: 30px;
  letter-spacing: -0.9px;
  margin: 6px 0 4px;
  color: #33273c;
  font-weight: 800;
}

.dashboard-topbar h1 em {
  font-family: Georgia, serif;
  color: #704be4;
  font-style: italic;
  font-weight: 500;
}

.dashboard-topbar p {
  font-size: 12px;
  color: #8c8297;
  margin: 0;
}

.user-chip {
  display: flex;
  align-items: center;
  gap: 10px;
  background: #ffffff;
  border: 1px solid #eeeaf3;
  padding: 8px 14px;
  border-radius: 12px;
  box-shadow: 0 4px 12px rgba(50, 30, 70, 0.03);
}

.user-avatar {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #eee7ff;
  color: #704be4;
  font-weight: 800;
  font-size: 13px;
}

.user-chip > span:last-child {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.user-chip strong {
  font-size: 11px;
  color: #33273c;
}

.user-chip small {
  font-size: 10px;
  color: #a49aaa;
}

.welcome-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  background: linear-gradient(105deg, #eae4ff, #f6f2ff 70%, #f2eaff);
  border: 1px solid #e7ddff;
  border-radius: 16px;
  padding: 24px 28px;
  margin-bottom: 26px;
}

.welcome-banner h2 {
  font-size: 23px;
  letter-spacing: -0.5px;
  margin: 6px 0 4px;
  color: #3c2d4c;
  font-weight: 800;
}

.welcome-banner p {
  font-size: 12px;
  color: #85759a;
  margin: 0;
  line-height: 1.6;
}

.welcome-side {
  display: flex;
  align-items: center;
  gap: 16px;
}

.welcome-art {
  font-size: 42px;
  color: #9b7fe6;
}

.welcome-side button {
  border: 1px solid #dfd3ff;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 9px;
  padding: 9px 14px;
  color: #704be4;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.15s;
}

.welcome-side button:hover {
  background: #ffffff;
  border-color: #704be4;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 15px;
  margin-bottom: 14px;
}

.section-title h2 {
  font-size: 18px;
  margin: 4px 0 0;
  letter-spacing: -0.3px;
  color: #33273c;
}

.period-chip {
  display: flex;
  align-items: center;
  gap: 7px;
  color: #8d8298;
  background: #ffffff;
  border: 1px solid #eeeaf3;
  border-radius: 30px;
  padding: 6px 12px;
  font-size: 10px;
  font-weight: 600;
}

.period-chip i,
.agent-status i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #42b778;
  display: inline-block;
}

/* KPI Cards */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
  margin-bottom: 24px;
}

.kpi-card {
  position: relative;
  display: grid;
  grid-template-columns: 36px 1fr;
  align-items: center;
  column-gap: 12px;
  row-gap: 4px;
  background: #ffffff;
  border: 1px solid #eeeaf3;
  border-radius: 14px;
  padding: 18px 16px;
  min-width: 0;
  box-shadow: 0 4px 14px rgba(50, 30, 70, 0.03);
}

.kpi-icon {
  grid-row: span 2;
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  font-size: 16px;
  font-weight: 800;
}

.revenue-icon {
  background: #eaf8ef;
  color: #35985e;
}

.units-icon {
  background: #eaf3ff;
  color: #407fcb;
}

.trend-icon {
  background: #fff3df;
  color: #ce8e23;
}

.product-icon {
  background: #f1ebff;
  color: #704be4;
}

.kpi-label {
  font-size: 11px;
  color: #92879e;
  font-weight: 600;
}

.kpi-placeholder {
  font-size: 21px;
  letter-spacing: -0.6px;
  font-weight: 800;
  color: #33273c;
  overflow-wrap: anywhere;
}

.kpi-card small {
  grid-column: 1 / -1;
  color: #aaa0b2;
  font-size: 10px;
  line-height: 1.4;
  margin-top: 6px;
}

/* Agent Spotlight */
.agent-spotlight {
  background: #ffffff;
  border: 1px solid #e9e2f5;
  border-radius: 16px;
  padding: 24px 26px;
  box-shadow: 0 8px 28px rgba(57, 32, 74, 0.05);
  margin-bottom: 22px;
  scroll-margin-top: 24px;
}

.agent-heading {
  display: flex;
  align-items: flex-start;
  gap: 14px;
}

.agent-mark {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  border-radius: 12px;
  background: #704be4;
  color: #ffffff;
  font-size: 24px;
  box-shadow: 0 6px 14px rgba(112, 75, 228, 0.25);
}

.agent-heading > div:nth-child(2) {
  flex: 1;
}

.agent-heading h2 {
  font-size: 19px;
  letter-spacing: -0.4px;
  margin: 4px 0 5px;
  color: #33273c;
}

.agent-heading p {
  font-size: 12px;
  line-height: 1.6;
  color: #8c8297;
  margin: 0;
  max-width: 720px;
}

.agent-status {
  display: flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
  background: #eff9f2;
  color: #388f58;
  border-radius: 20px;
  padding: 6px 12px;
  font-size: 10px;
  font-weight: 700;
}

.assistant-form {
  display: flex;
  align-items: stretch;
  gap: 10px;
  margin-top: 18px;
}

.question-wrap {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  flex: 1;
  min-width: 0;
  border: 1px solid #e3dcfa;
  border-radius: 11px;
  background: #fdfcff;
  padding: 10px 14px;
}

.question-wrap > span {
  font-size: 18px;
  color: #704be4;
}

.question-wrap textarea {
  flex: 1;
  min-width: 0;
  resize: vertical;
  min-height: 44px;
  border: 0;
  outline: 0;
  background: transparent;
  font: 12px / 1.6 'DM Sans', Arial, sans-serif;
  color: #45374f;
}

.assistant-form > button {
  align-self: stretch;
  border: 0;
  border-radius: 10px;
  padding: 0 20px;
  background: #704be4;
  color: #ffffff;
  font-size: 11px;
  font-weight: 800;
  cursor: pointer;
  transition: background 0.15s;
}

.assistant-form > button:hover:not(:disabled) {
  background: #5e3acb;
}

.assistant-form > button:disabled {
  opacity: 0.55;
  cursor: wait;
}

.quick-asks {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 14px;
}

.quick-asks > span {
  font-size: 10px;
  color: #9e93a7;
  font-weight: 700;
}

.quick-asks button {
  border: 1px solid #eee8f7;
  border-radius: 20px;
  background: #ffffff;
  padding: 6px 12px;
  color: #7451cb;
  font-size: 10px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s;
}

.quick-asks button:hover {
  background: #f5efff;
  border-color: #dfd3fc;
}

.assistant-answer {
  margin-top: 18px;
  padding: 18px;
  background: #f6f2ff;
  border: 1px solid #eae1ff;
  border-radius: 12px;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.answer-label {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.8px;
  color: #704be4;
}

.answer-label span {
  font-size: 14px;
  margin-right: 5px;
}

.assistant-answer p {
  font-size: 12px;
  line-height: 1.8;
  color: #493b54;
  margin: 10px 0 0;
}

.assistant-error,
.analytics-error {
  padding: 12px 14px;
  background: #fff0f1;
  border: 1px solid #f2d6da;
  border-radius: 9px;
  color: #a34250;
  font-size: 11px;
  line-height: 1.6;
  margin-top: 12px;
}

.analytics-error button {
  margin-left: 8px;
  border: 0;
  background: none;
  color: #704be4;
  text-decoration: underline;
  cursor: pointer;
  font-weight: 700;
}

/* Lower Grid */
.lower-grid {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 16px;
}

.panel {
  background: #ffffff;
  border: 1px solid #eeeaf3;
  border-radius: 15px;
  padding: 22px;
  min-width: 0;
}

.panel-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
}

.panel-top h3 {
  font-size: 16px;
  margin: 4px 0 0;
  letter-spacing: -0.3px;
  color: #33273c;
}

.panel-icon {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  background: #f1ecff;
  color: #704be4;
  font-size: 16px;
}

.action-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 0;
  border-top: 1px solid #f1edf5;
  text-decoration: none;
  transition: all 0.15s;
}

.action-row:hover {
  transform: translateX(2px);
}

.action-symbol {
  width: 32px;
  height: 32px;
  border-radius: 9px;
  background: #eaf4ff;
  color: #4578b8;
  display: grid;
  place-items: center;
  font-size: 15px;
}

.action-symbol.pink {
  background: #fff0f4;
  color: #c9527b;
}

.action-row > span:nth-child(2) {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 3px;
}

.action-row strong {
  font-size: 11px;
  color: #3d2f47;
}

.action-row small {
  font-size: 10px;
  color: #9a90a3;
}

.action-row > b {
  color: #704be4;
}

.opportunity-panel > p {
  font-size: 12px;
  line-height: 1.7;
  color: #897d95;
}

.text-link {
  display: inline-block;
  margin-top: 8px;
  color: #704be4;
  text-decoration: none;
  font-size: 11px;
  font-weight: 800;
}

.analytics-details {
  margin-top: 16px;
  color: #8c8198;
  font-size: 11px;
}

.analytics-details summary {
  cursor: pointer;
}

.analytics-details pre {
  max-height: 250px;
  overflow: auto;
  padding: 14px;
  background: #ffffff;
  border: 1px solid #eeeaf3;
  border-radius: 9px;
  font-size: 11px;
  white-space: pre-wrap;
}

.business-footer {
  display: flex;
  align-items: center;
  gap: 14px;
  background: #f1ecff;
  border: 1px solid #e8dfff;
  border-radius: 14px;
  padding: 16px 20px;
  margin-top: 22px;
}

.business-footer > span {
  font-size: 24px;
  color: #704be4;
}

.business-footer div {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 3px;
}

.business-footer strong {
  font-size: 12px;
  color: #33273c;
}

.business-footer small {
  font-size: 10px;
  color: #8b7ca3;
}

.business-footer button {
  border: 1px solid #ddd0ff;
  background: #ffffff;
  border-radius: 8px;
  padding: 9px 14px;
  color: #704be4;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.15s;
}

.business-footer button:hover {
  background: #fbf9ff;
  border-color: #704be4;
}

/* =========================================================
   RESPONSIVE LAYOUT & MOBILE DRAWER (375px, 390px, 430px)
   ========================================================= */

@media (max-width: 900px) {
  .dashboard-shell {
    display: flex;
    flex-direction: column;
  }

  /* Sticky Mobile Header */
  .mobile-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    background: #ffffff;
    border-bottom: 1px solid #eeeaf2;
    position: sticky;
    top: 0;
    z-index: 500;
  }

  .btn-hamburger {
    width: 44px;
    height: 44px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    background: #f6f2ff;
    border: 1px solid #e6dcfa;
    border-radius: 10px;
    cursor: pointer;
    color: #704be4;
    padding: 0;
    flex-shrink: 0;
  }

  .hamburger-line {
    display: block;
    width: 20px;
    height: 2px;
    background: #704be4;
    border-radius: 2px;
  }

  .mobile-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: #33273c;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.5px;
  }

  .mobile-biz-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #f9f6ff;
    border: 1px solid #ebdffd;
    padding: 6px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    color: #6843d4;
    max-width: 140px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Off-canvas Sliding Drawer Sidebar */
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 280px;
    max-width: 85vw;
    height: 100vh;
    background: #ffffff;
    box-shadow: 0 0 40px rgba(25, 10, 40, 0.3);
    z-index: 1000;
    transform: translateX(-100%);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    overflow-y: auto;
    padding: 16px;
  }

  .sidebar.drawer-open {
    transform: translateX(0);
  }

  .mobile-sidebar-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 14px;
    margin-bottom: 8px;
    border-bottom: 1px solid #f2edf7;
  }

  .drawer-heading {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.2px;
    color: #9277ce;
  }

  .btn-close-drawer {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    background: #f4f0fa;
    border: 0;
    border-radius: 8px;
    color: #6d5b88;
    font-size: 18px;
    cursor: pointer;
  }

  .mobile-drawer-overlay {
    display: block;
    position: fixed;
    inset: 0;
    background: rgba(25, 15, 38, 0.5);
    backdrop-filter: blur(2px);
    z-index: 999;
  }

  .dashboard-main {
    padding: 20px 14px;
  }

  .dashboard-topbar {
    align-items: flex-start;
    flex-direction: column;
    gap: 12px;
  }

  .user-chip {
    width: 100%;
    box-sizing: border-box;
  }

  .welcome-banner {
    padding: 18px;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .welcome-side {
    width: 100%;
    justify-content: space-between;
  }

  .kpi-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .assistant-form {
    flex-direction: column;
  }

  .assistant-form > button {
    min-height: 44px; /* Touch-friendly button */
    padding: 12px;
  }

  .lower-grid {
    grid-template-columns: 1fr;
  }

  .business-footer {
    flex-direction: column;
    align-items: flex-start;
  }

  .business-footer button {
    width: 100%;
    min-height: 42px;
  }
}

@media (max-width: 480px) {
  .kpi-grid {
    grid-template-columns: 1fr;
  }
}
