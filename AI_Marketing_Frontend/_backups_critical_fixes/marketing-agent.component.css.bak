:host {
  display: block;
  color: #342a3b;
}

.marketing-shell {
  min-height: 100vh;
  background: #f8f7fb;
  display: flex;
  font-family: inherit;
  position: relative;
}

/* =========================================================
   MOBILE HEADER & OVERLAY (Default hidden on desktop)
   ========================================================= */

.mobile-topbar {
  display: none;
}

.mobile-drawer-overlay {
  display: none;
}

.mobile-sidebar-head {
  display: none;
}

/* =========================================================
   SIDEBAR (Desktop)
   ========================================================= */

.marketing-sidebar {
  width: 250px;
  flex: 0 0 250px;
  background: #ffffff;
  border-right: 1px solid #eeeaf3;
  padding: 24px 16px 20px;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
  z-index: 100;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #30263a;
  text-decoration: none;
  font-weight: 800;
  font-size: 20px;
  letter-spacing: -0.6px;
  padding: 0 8px 24px;
}

.brand-mark,
.brand-symbol {
  display: grid;
  place-items: center;
  background: #704be4;
  color: #ffffff;
  border-radius: 11px;
  width: 36px;
  height: 36px;
  font-size: 22px;
  box-shadow: 0 4px 12px rgba(112, 75, 228, 0.25);
}

.brand .dot,
.brand-dot {
  color: #8058ed;
}

.brand small {
  display: block;
  font-size: 8px;
  letter-spacing: 1.4px;
  color: #a49aaf;
  margin-top: 3px;
  font-weight: 700;
}

.nav-caption,
.eyebrow {
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1.3px;
  color: #aaa1b3;
  text-transform: uppercase;
}

.nav-caption {
  margin: 16px 10px 6px;
}

.nav-group-caption {
  margin-top: 16px;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  border-radius: 9px;
  text-decoration: none;
  color: #6d627a;
  font-size: 12px;
  font-weight: 600;
  margin: 2px 0;
  transition: all 0.15s ease;
}

.nav-link:hover {
  background: #f7f3ff;
  color: #704be4;
}

.nav-link.active {
  background: #f0ebff;
  color: #6843d4;
  font-weight: 700;
}

.sidebar-note {
  margin-top: auto;
  background: #f8f5ff;
  border: 1px solid #eee7ff;
  border-radius: 12px;
  padding: 14px 12px;
  color: #704be4;
}

.sidebar-note > span {
  font-size: 20px;
}

.sidebar-note strong {
  display: block;
  font-size: 12px;
  margin-top: 6px;
  color: #342a3b;
}

.sidebar-note p {
  font-size: 11px;
  line-height: 1.5;
  color: #817393;
  margin: 4px 0 0;
}

.sidebar-user {
  display: flex;
  align-items: center;
  gap: 10px;
  border-top: 1px solid #f0edf4;
  padding-top: 14px;
  margin-top: 14px;
}

.avatar {
  display: grid;
  place-items: center;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #eee6ff;
  color: #704bdb;
  font-size: 13px;
  font-weight: 800;
}

.sidebar-user div {
  min-width: 0;
  flex: 1;
}

.sidebar-user strong,
.sidebar-user small {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-user strong {
  font-size: 11px;
  color: #3d2f4a;
}

.sidebar-user small {
  font-size: 9px;
  color: #988ea2;
  margin-top: 2px;
}

.sidebar-user button {
  border: 0;
  background: transparent;
  color: #8f849a;
  cursor: pointer;
  font-size: 18px;
  padding: 4px;
  border-radius: 6px;
  transition: color 0.15s;
}

.sidebar-user button:hover {
  color: #704be4;
}

/* =========================================================
   MARKETING MAIN CONTENT
   ========================================================= */

.marketing-main {
  max-width: 1500px;
  min-width: 0;
  flex: 1;
  padding: 32px clamp(20px, 4vw, 54px) 30px;
  margin: 0 auto;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 24px;
}

.topbar h1 {
  font-size: 30px;
  letter-spacing: -0.9px;
  margin: 6px 0 4px;
  color: #33273c;
  font-weight: 800;
}

.topbar h1 em {
  font-style: italic;
  font-family: Georgia, serif;
  color: #704be4;
  font-weight: 500;
}

.topbar p,
.panel-heading p {
  color: #8c8297;
  font-size: 12px;
  margin: 0;
  line-height: 1.6;
}

.business-chip {
  display: flex;
  align-items: center;
  gap: 10px;
  background: #ffffff;
  border: 1px solid #eeeaf3;
  border-radius: 12px;
  padding: 8px 14px;
  max-width: 260px;
  box-shadow: 0 4px 12px rgba(50, 30, 70, 0.03);
}

.business-chip > span {
  width: 32px;
  height: 32px;
  border-radius: 9px;
  background: #f0ebff;
  color: #704be4;
  display: grid;
  place-items: center;
  font-size: 14px;
  flex-shrink: 0;
}

.business-chip small,
.business-chip strong {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.business-chip small {
  font-size: 9px;
  color: #988ea2;
  letter-spacing: 0.8px;
}

.business-chip strong {
  font-size: 11px;
  color: #33273c;
  margin-top: 2px;
}

.intro-banner {
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 20px 24px;
  border-radius: 16px;
  background: linear-gradient(110deg, #eae4ff, #f6f2ff);
  border: 1px solid #e6dcfe;
  margin-bottom: 24px;
}

.intro-icon {
  width: 48px;
  height: 48px;
  flex: 0 0 48px;
  border-radius: 13px;
  background: #ffffff;
  color: #704be4;
  display: grid;
  place-items: center;
  font-size: 24px;
  box-shadow: 0 4px 12px rgba(112, 75, 228, 0.15);
}

.intro-banner span {
  font-size: 9px;
  letter-spacing: 1.2px;
  color: #704be4;
  font-weight: 800;
}

.intro-banner h2 {
  font-size: 18px;
  margin: 4px 0;
  color: #33273c;
}

.intro-banner p {
  font-size: 12px;
  color: #817393;
  margin: 0;
}

.studio-grid {
  display: grid;
  grid-template-columns: minmax(320px, 0.85fr) minmax(360px, 1.15fr);
  gap: 24px;
  align-items: start;
}

.panel {
  background: #ffffff;
  border: 1px solid #eeeaf3;
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 6px 22px rgba(57, 39, 84, 0.03);
}

.campaign-form {
  position: sticky;
  top: 24px;
}

.panel-heading,
.result-heading {
  display: flex;
  align-items: center;
  gap: 12px;
  justify-content: space-between;
  margin-bottom: 20px;
}

.panel-heading h2,
.result-heading h2 {
  font-size: 17px;
  margin: 3px 0 2px;
  color: #33273c;
}

.step-badge,
.result-icon {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: #f0ebff;
  color: #704be4;
  flex-shrink: 0;
  font-size: 16px;
}

.campaign-form label {
  display: block;
  font-size: 12px;
  font-weight: 700;
  color: #4b3d57;
  margin-bottom: 14px;
}

.campaign-form input,
.campaign-form textarea,
.campaign-form select {
  display: block;
  width: 100%;
  box-sizing: border-box;
  border: 1px solid #e3dcfa;
  border-radius: 9px;
  padding: 10px 13px;
  margin-top: 6px;
  background: #fdfcff;
  color: #342a3b;
  font: inherit;
  font-size: 12px;
  outline: none;
  transition: all 0.15s ease;
}

.campaign-form input:focus,
.campaign-form textarea:focus,
.campaign-form select:focus {
  border-color: #704be4;
  box-shadow: 0 0 0 3px rgba(112, 75, 228, 0.15);
  background: #ffffff;
}

.campaign-form textarea {
  resize: vertical;
}

.field-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.optional {
  font-weight: 400;
  color: #988ea2;
}

.primary-button,
.secondary-button {
  border: 0;
  border-radius: 10px;
  padding: 12px 18px;
  font-weight: 750;
  font-size: 12px;
  cursor: pointer;
  transition: all 0.15s ease;
}

.primary-button {
  background: #704be4;
  color: #ffffff;
  box-shadow: 0 4px 14px rgba(112, 75, 228, 0.25);
}

.primary-button:hover:not(:disabled) {
  background: #5e3acb;
  transform: translateY(-1px);
}

.primary-button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.campaign-form .primary-button {
  width: 100%;
  display: flex;
  justify-content: center;
  gap: 8px;
  align-items: center;
  min-height: 46px;
}

.form-footnote {
  font-size: 10px;
  line-height: 1.5;
  color: #988ea2;
  text-align: center;
  margin: 10px 0 0;
}

.results-column {
  display: grid;
  gap: 16px;
  min-width: 0;
}

.strategy-panel .result-heading {
  justify-content: flex-start;
  margin-bottom: 14px;
}

.result-icon.purple {
  background: #f0ebff;
  color: #704be4;
}

.status {
  margin-left: auto;
  border-radius: 100px;
  padding: 5px 10px;
  background: #fff4dd;
  color: #956411;
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
}

.status.published {
  background: #e6f8ee;
  color: #16804b;
}

.strategy-copy {
  font-size: 13px;
  line-height: 1.75;
  color: #4b3d57;
  white-space: pre-wrap;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 16px;
}

.meta-row span {
  font-size: 10px;
  background: #f8f7fb;
  color: #786b85;
  padding: 6px 10px;
  border-radius: 8px;
  border: 1px solid #eeeaf3;
}

/* Poster Artwork Component */
.generated-image-wrap {
  width: 100%;
  max-width: 540px;
  margin: 0 auto;
  min-width: 0;
}

.creative-poster {
  position: relative;
  isolation: isolate;
  width: 100%;
  aspect-ratio: 4 / 5;
  max-height: 600px;
  overflow: hidden;
  border-radius: 16px;
  background: #211b23;
  box-shadow: 0 16px 40px rgba(28, 20, 35, 0.18);
  color: #ffffff;
}

.generated-poster-image {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  max-width: 100%;
  object-fit: cover;
  object-position: center;
  border-radius: inherit;
}

.creative-shade {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    180deg,
    rgba(15, 12, 18, 0.38) 0%,
    rgba(15, 12, 18, 0.06) 30%,
    rgba(15, 12, 18, 0.18) 47%,
    rgba(15, 12, 18, 0.88) 100%
  );
}

.creative-copy {
  position: absolute;
  z-index: 2;
  left: clamp(16px, 5%, 32px);
  right: clamp(16px, 5%, 32px);
  bottom: clamp(24px, 8%, 48px);
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  gap: 8px;
  overflow-wrap: anywhere;
}

.creative-business {
  font-size: clamp(10px, 1.5vw, 12px);
  font-weight: 800;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
}

.creative-kicker {
  font-size: 9px;
  letter-spacing: 1.5px;
  font-weight: 800;
  color: #f5d8a5;
  text-transform: uppercase;
}

.creative-copy h3 {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: clamp(26px, 3.8vw, 42px);
  line-height: 1.05;
  letter-spacing: -0.8px;
  margin: 0;
  max-width: 100%;
  text-shadow: 0 2px 14px rgba(0, 0, 0, 0.5);
}

.creative-copy p {
  font-size: clamp(11px, 1.4vw, 14px);
  line-height: 1.5;
  margin: 0;
  max-width: 34ch;
  color: #ffffff;
  overflow-wrap: anywhere;
  text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
}

.creative-cta {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  margin-top: 6px;
  padding: 10px 16px;
  border-radius: 999px;
  background: #ffffff;
  color: #342a3b;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  max-width: 100%;
  overflow-wrap: anywhere;
}

.creative-cta b {
  font-size: 14px;
  color: #704be4;
}

.creative-brand {
  position: absolute;
  z-index: 2;
  top: 18px;
  left: 20px;
  right: 20px;
  font-size: 8px;
  letter-spacing: 1.5px;
  font-weight: 800;
  color: #ffffff;
  text-transform: uppercase;
  text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
}

.poster-preview {
  position: relative;
  overflow: hidden;
  min-height: 300px;
  border-radius: 16px;
  background: linear-gradient(135deg, #704be4, #a88df7);
  color: white;
  padding: 24px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}

.poster-orbit {
  position: absolute;
  width: 210px;
  height: 210px;
  border: 35px solid rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  right: -45px;
  top: -70px;
}

.poster-business {
  font-size: 10px;
  letter-spacing: 2px;
  font-weight: 800;
  text-transform: uppercase;
  position: relative;
}

.poster-main {
  font-size: clamp(26px, 3vw, 40px);
  font-weight: 850;
  line-height: 1.12;
  letter-spacing: -1px;
  max-width: 420px;
  margin-top: 40px;
  position: relative;
  overflow-wrap: anywhere;
}

.poster-sub {
  font-size: 13px;
  line-height: 1.5;
  max-width: 380px;
  margin-top: 12px;
  position: relative;
  overflow-wrap: anywhere;
}

.poster-cta {
  background: white;
  color: #5535c2;
  border-radius: 50px;
  padding: 10px 18px;
  font-weight: 800;
  font-size: 11px;
  align-self: flex-start;
  margin-top: 24px;
  position: relative;
}

.poster-foot {
  font-size: 8px;
  letter-spacing: 1.2px;
  opacity: 0.8;
  margin-top: 20px;
  position: relative;
}

.poster-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-top: 14px;
}

.secondary-button {
  background: #f0ebff;
  color: #704be4;
  width: 100%;
}

.secondary-button:hover {
  background: #e7deff;
}

.output-label {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.2px;
  color: #988ea2;
  text-transform: uppercase;
}

.caption-copy {
  font-size: 13px;
  line-height: 1.75;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  color: #4b3d57;
  margin: 10px 0;
}

.text-button {
  border: 0;
  background: transparent;
  color: #704be4;
  font-weight: 750;
  font-size: 11px;
  padding: 5px 0;
  cursor: pointer;
}

.text-button:hover {
  text-decoration: underline;
}

.output-divider {
  height: 1px;
  background: #eeeaf3;
  margin: 16px 0;
}

.hashtags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin: 10px 0;
}

.hashtags span {
  font-size: 11px;
  color: #704be4;
  background: #f0ebff;
  border-radius: 8px;
  padding: 6px 10px;
}

.content-note {
  font-size: 10px;
  line-height: 1.5;
  color: #988ea2;
  margin: 14px 0 0;
}

.publish-panel {
  border-radius: 16px;
  background: #342a3b;
  color: white;
  padding: 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.publish-panel h2 {
  font-size: 17px;
  margin: 4px 0;
}

.publish-panel p {
  font-size: 12px;
  color: #d5ccdf;
  margin: 0 0 6px;
}

.publish-panel small {
  font-size: 10px;
  color: #c2b5d1;
}

.publish-panel .eyebrow {
  color: #c3b2ff;
}

.publish-button {
  white-space: nowrap;
  background: #ffffff;
  color: #5e3acb;
  box-shadow: none;
}

.publish-button:hover {
  background: #f4efff;
}

.published-check {
  background: #d8f8e6;
  color: #147b47;
  border-radius: 10px;
  padding: 10px 14px;
  font-size: 11px;
  font-weight: 800;
  white-space: nowrap;
}

.disclaimer {
  font-size: 10px;
  line-height: 1.6;
  color: #988ea2;
  margin: 0 3px;
}

.empty-results {
  background: #ffffff;
  border: 1px dashed #dcd2f2;
  border-radius: 16px;
  padding: 32px 28px;
  min-height: 440px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
}

.empty-art {
  width: 110px;
  height: 100px;
  position: relative;
  margin-bottom: 24px;
}

.empty-art span {
  position: absolute;
  display: grid;
  place-items: center;
  width: 80px;
  height: 80px;
  border-radius: 24px;
  background: #f0ebff;
  color: #704be4;
  font-size: 38px;
  left: 4px;
  top: 0;
}

.empty-art i,
.empty-art b {
  position: absolute;
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  font-style: normal;
  background: #e6f8ee;
  color: #16804b;
  right: 2px;
  top: 8px;
}

.empty-art b {
  top: 58px;
  right: 16px;
  background: #fff0e8;
  color: #b85b37;
}

.empty-results h2 {
  font-size: 21px;
  max-width: 340px;
  line-height: 1.3;
  margin: 8px 0;
  color: #33273c;
}

.empty-results p {
  font-size: 12px;
  line-height: 1.7;
  color: #988ea2;
  max-width: 380px;
}

.empty-steps {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 18px;
}

.empty-steps span {
  font-size: 10px;
  color: #704be4;
  background: #f0ebff;
  border-radius: 8px;
  padding: 8px 10px;
}

.empty-steps b {
  color: #594b66;
  margin-left: 4px;
}

.notice {
  padding: 12px 14px;
  border-radius: 10px;
  font-size: 12px;
  margin-bottom: 14px;
}

.notice.error {
  background: #fff0ef;
  color: #b42318;
  border: 1px solid #ffd6d2;
}

.notice.success {
  background: #e9f9ef;
  color: #167446;
  border: 1px solid #c9efd7;
}

.page-footer {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  color: #988ea2;
  font-size: 10px;
  margin-top: 28px;
}

.page-footer span:first-child {
  color: #704be4;
  font-weight: 800;
}

/* =========================================================
   RESPONSIVE LAYOUT & MOBILE DRAWER (375px, 390px, 430px)
   ========================================================= */

@media (max-width: 900px) {
  .marketing-shell {
    display: flex;
    flex-direction: column;
  }

  /* Sticky Mobile Header */
  .mobile-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    background: #ffffff;
    border-bottom: 1px solid #eeeaf2;
    position: sticky;
    top: 0;
    z-index: 500;
  }

  .btn-hamburger {
    width: 44px;
    height: 44px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    background: #f6f2ff;
    border: 1px solid #e6dcfa;
    border-radius: 10px;
    cursor: pointer;
    color: #704be4;
    padding: 0;
    flex-shrink: 0;
  }

  .hamburger-line {
    display: block;
    width: 20px;
    height: 2px;
    background: #704be4;
    border-radius: 2px;
  }

  .mobile-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: #33273c;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.5px;
  }

  .mobile-biz-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #f9f6ff;
    border: 1px solid #ebdffd;
    padding: 6px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    color: #6843d4;
    max-width: 140px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Off-canvas Sliding Drawer Sidebar */
  .marketing-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 280px;
    max-width: 85vw;
    height: 100vh;
    background: #ffffff;
    box-shadow: 0 0 40px rgba(25, 10, 40, 0.3);
    z-index: 1000;
    transform: translateX(-100%);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    overflow-y: auto;
    padding: 16px;
  }

  .marketing-sidebar.drawer-open {
    transform: translateX(0);
  }

  .mobile-sidebar-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 14px;
    margin-bottom: 8px;
    border-bottom: 1px solid #f2edf7;
  }

  .drawer-heading {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.2px;
    color: #9277ce;
  }

  .btn-close-drawer {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    background: #f4f0fa;
    border: 0;
    border-radius: 8px;
    color: #6d5b88;
    font-size: 18px;
    cursor: pointer;
  }

  .mobile-drawer-overlay {
    display: block;
    position: fixed;
    inset: 0;
    background: rgba(25, 15, 38, 0.5);
    backdrop-filter: blur(2px);
    z-index: 999;
  }

  .marketing-main {
    padding: 20px 14px;
  }

  .topbar {
    align-items: flex-start;
    flex-direction: column;
    gap: 12px;
  }

  .business-chip {
    max-width: none;
    width: 100%;
    box-sizing: border-box;
  }

  .studio-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .campaign-form {
    position: static;
  }

  .field-row {
    grid-template-columns: 1fr;
  }

  .poster-actions {
    grid-template-columns: 1fr;
  }

  .publish-panel {
    flex-direction: column;
    align-items: flex-start;
  }

  .publish-button {
    width: 100%;
    min-height: 44px;
  }
}
