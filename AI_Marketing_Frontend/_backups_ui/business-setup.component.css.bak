:host{display:block;min-height:100vh;color:#342a3b}.business-setup-page{min-height:100vh;background:#f8f7fb;padding:24px clamp(16px,4vw,56px) 48px}.setup-brand{display:inline-flex;align-items:center;gap:8px;color:#352a3d;text-decoration:none;font-size:21px;font-weight:850;letter-spacing:-.8px;margin:0 0 25px}.setup-brand>span:first-child{display:grid;place-items:center;width:35px;height:35px;border-radius:11px;background:#704be4;color:#fff;font-size:22px}.brand-dot{color:#8059e9}.setup-layout{width:min(1180px,100%);margin:0 auto;display:grid;grid-template-columns:minmax(230px,.72fr) minmax(0,1.55fr);gap:clamp(24px,5vw,66px);align-items:start}.setup-story{position:sticky;top:35px;padding:35px 4px}.section-kicker{font-size:9px;letter-spacing:1.35px;font-weight:850;color:#9277ce}.setup-story h1{font-size:clamp(31px,4vw,47px);line-height:1.12;letter-spacing:-1.7px;margin:16px 0;color:#33273c}.setup-story h1 em{font-family:Georgia,serif;color:#805de0;font-weight:500}.setup-story>p{max-width:340px;color:#91869c;font-size:13px;line-height:1.9}.story-note{margin-top:26px;color:#7655ca;font-size:11px;font-weight:700}.setup-progress{margin-top:70px;padding:17px;border:1px solid #e9e2f5;border-radius:13px;background:#fff;max-width:300px}.setup-progress>span,.setup-progress>strong,.setup-progress>small{display:block}.setup-progress>span{font-size:8px;letter-spacing:1.1px;color:#9a8cae;font-weight:800}.setup-progress>strong{font-size:12px;margin-top:7px}.setup-progress>div{height:5px;background:#eee9f7;border-radius:10px;margin:13px 0 9px;overflow:hidden}.setup-progress i{display:block;width:100%;height:100%;background:#805de0;border-radius:10px}.setup-progress>small{font-size:9px;color:#a49aaa}.setup-content{min-width:0}.setup-heading{margin:0 0 20px}.setup-heading h2{font-size:26px;letter-spacing:-.8px;margin:7px 0 5px}.setup-heading p{font-size:12px;color:#978da1;margin:0}.setup-card{background:#fff;border:1px solid #eeeaf3;border-radius:15px;padding:22px 23px;margin-bottom:14px;box-shadow:0 7px 25px #38204a05}.setup-card-heading{display:flex;align-items:center;gap:12px;margin-bottom:19px}.setup-step{width:34px;height:34px;display:grid;place-items:center;flex:0 0 34px;border-radius:10px;background:#f0ebff;color:#7651d8;font-size:10px;font-weight:850}.setup-card-heading h3{font-size:14px;margin:0 0 4px}.setup-card-heading p{font-size:10px;color:#a097aa;margin:0}.setup-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px 17px}.setup-fields label{display:block;min-width:0;font-size:10px;font-weight:750;color:#665875}.setup-fields label b{color:#d65d70}.setup-fields .optional{font-weight:450;color:#aaa0b2}.setup-fields input,.setup-fields select,.setup-fields textarea{display:block;width:100%;box-sizing:border-box;margin-top:7px;border:1px solid #e7e1ed;border-radius:9px;background:#fdfcff;padding:11px 12px;color:#44364f;font-size:12px;line-height:1.5;font-family:inherit;outline:none;min-height:41px}.setup-fields textarea{resize:vertical}.setup-fields input:focus,.setup-fields select:focus,.setup-fields textarea:focus{border-color:#a58be9;box-shadow:0 0 0 3px #f0ebff}.field-wide{grid-column:1/-1}.setup-submit-area{padding:5px 2px 0}.setup-submit{display:flex;align-items:center;justify-content:center;gap:12px;width:100%;border:0;border-radius:10px;background:#704be4;color:#fff;padding:14px 18px;font-size:12px;font-weight:800;cursor:pointer}.setup-submit:disabled{opacity:.6;cursor:wait}.setup-submit-area>small{display:block;text-align:center;color:#a49aaa;font-size:9px;margin-top:10px}.form-error{padding:10px 12px;border:1px solid #f2d8dc;border-radius:8px;background:#fff0f1;color:#a43c4b;font-size:11px;line-height:1.6;margin:0 0 12px}@media(max-width:800px){.setup-layout{grid-template-columns:1fr;gap:12px}.setup-story{position:static;padding:5px 0 0}.setup-story h1{font-size:34px;margin:9px 0}.setup-story>p{max-width:620px;margin-bottom:0}.setup-progress{display:none}.story-note{margin-top:12px}.setup-content{margin-top:8px}}@media(max-width:540px){.business-setup-page{padding:16px 12px 30px}.setup-brand{margin-bottom:14px}.setup-story h1{font-size:30px}.setup-card{padding:17px 14px}.setup-fields{grid-template-columns:1fr;gap:13px}.field-wide{grid-column:auto}.setup-heading h2{font-size:23px}}
